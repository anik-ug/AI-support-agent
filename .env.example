# ===== Dataset =====
# Absolute path is recommended. Example on macOS:
# DATASET_PATH=/Users/anikkumar/Downloads/twcs/twcs.csv
DATASET_PATH=

# Optional. Leave empty to automatically select the highest-volume outbound support account.
# After running `python scripts/inspect_dataset.py`, you can pin a specific author_id here.
BRAND_ID=

# ===== Reproducibility / data sizing =====
RANDOM_SEED=13
SAMPLE_SIZE=2500
MAX_CONVERSATIONS_PER_BRAND=1000
GOLDEN_EVAL_SIZE=200
EVAL_RATIO=0.20

# ===== Retrieval =====
TOP_K_RETRIEVAL=5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_FAISS=0

# ===== LLM =====
# Supported: openai or gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=

# ===== Escalation =====
MIN_INTENT_CONFIDENCE=0.55
MIN_SIMILARITY=0.45
MIN_RETRIEVAL_HITS=2
